{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Akeek Astro — Matrix section file (Schema v2)",
  "description": "ملف قسم واحد من أقسام المصفوفة: 22 مدخلاً، لكل أركانا طبقتان (summary مختصر و deep مفصّل) وتمايز جندري genderDynamic. حقول deep تختلف حسب القسم.",
  "type": "object",
  "required": ["schemaVersion", "contentType", "section", "title", "contentVersion", "updated", "language", "engineMapping", "safetyNote", "entries"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contentType": { "const": "matrix-section" },
    "section": { "enum": ["center", "love_line", "money_line", "talents", "father_line", "mother_line", "purposes", "children_line", "transformation_rx", "ancestral_programs", "age_cycles"] },
    "cleaningNote": { "type": "string" },
    "missingIds": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 22 }, "description": "أركانا مفيهاش نص مصدري في الأرشيف (القسم جزئي)." },
    "title": { "$ref": "#/$defs/text" },
    "positionNote": { "$ref": "#/$defs/text" },
    "contentVersion": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "language": { "const": "ar" },
    "sources": { "type": "array", "items": { "type": "string" } },
    "engineMapping": { "enum": ["unverified", "verified"] },
    "safetyNote": { "$ref": "#/$defs/text" },
    "entries": { "type": "array", "minItems": 1, "maxItems": 22, "items": { "$ref": "#/$defs/entry" }, "description": "22 مدخل، أو أقل مع تعريف missingIds." }
  },
  "allOf": [
    { "if": { "properties": { "section": { "const": "center" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "$ref": "#/$defs/deepCenter" } } } } } } },
    { "if": { "properties": { "section": { "const": "money_line" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "$ref": "#/$defs/deepMoney" } } } } } } },
    { "if": { "properties": { "section": { "const": "love_line" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "$ref": "#/$defs/deepLove" } } } } } } },
    { "if": { "properties": { "section": { "const": "talents" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "$ref": "#/$defs/deepTalents" } } } } } } },
    { "if": { "properties": { "section": { "const": "purposes" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "type": "object", "required": ["mission", "maturityTest"], "additionalProperties": false, "properties": { "mission": { "$ref": "#/$defs/text" }, "maturityTest": { "$ref": "#/$defs/text" } } } } } } } } },
    { "if": { "properties": { "section": { "const": "ancestral_programs" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "type": "object", "required": ["roots", "path"], "additionalProperties": false, "properties": { "roots": { "$ref": "#/$defs/text" }, "fallPatterns": { "type": "array", "items": { "$ref": "#/$defs/text" } }, "path": { "$ref": "#/$defs/text" } } } } } } } } },
    { "if": { "properties": { "section": { "const": "children_line" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "type": "object", "required": ["family"], "additionalProperties": false, "properties": { "family": { "$ref": "#/$defs/text" } } } } } } } } },
    { "if": { "properties": { "section": { "const": "transformation_rx" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "type": "object", "required": ["protocol"], "additionalProperties": false, "properties": { "protocol": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }, "reflectiveQuestions": { "type": "array", "items": { "$ref": "#/$defs/text" } } } } } } } } } },
    { "if": { "properties": { "section": { "const": "age_cycles" } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "type": "object", "required": ["stage", "light", "shadow", "practice"], "additionalProperties": false, "properties": { "stage": { "$ref": "#/$defs/text" }, "light": { "$ref": "#/$defs/text" }, "shadow": { "$ref": "#/$defs/text" }, "practice": { "$ref": "#/$defs/text" } } } } } } } } },
    { "if": { "properties": { "section": { "enum": ["father_line", "mother_line"] } } }, "then": { "properties": { "entries": { "items": { "properties": { "deep": { "$ref": "#/$defs/deepFamily" } } } } } } }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "^[^<>\"]*$" },
    "entry": {
      "type": "object",
      "required": ["id", "arcana", "summary", "deep", "meta"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 22 },
        "arcana": {
          "type": "object",
          "required": ["ar", "en"],
          "additionalProperties": false,
          "properties": { "ar": { "$ref": "#/$defs/text" }, "en": { "$ref": "#/$defs/text" } }
        },
        "summary": { "$ref": "#/$defs/text" },
        "deep": { "type": "object" },
        "genderDynamic": {
          "type": "object",
          "required": ["female", "male"],
          "additionalProperties": false,
          "properties": { "female": { "$ref": "#/$defs/text" }, "male": { "$ref": "#/$defs/text" } }
        },
        "meta": {
          "type": "object",
          "required": ["status", "source"],
          "properties": {
            "status": { "enum": ["draft", "review", "ready", "published"] },
            "source": { "enum": ["archive", "authored"] },
            "sourceNote": { "type": "string" }
          }
        }
      }
    },
    "deepCenter": {
      "type": "object",
      "required": ["identity", "behavior", "shadow", "balanceKey"],
      "additionalProperties": false,
      "properties": {
        "identity": { "$ref": "#/$defs/text" },
        "behavior": { "$ref": "#/$defs/text" },
        "shadow": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "balanceKey": { "$ref": "#/$defs/text" }
      }
    },
    "deepMoney": {
      "type": "object",
      "required": ["inflow", "blocks", "sectors", "goldenRule"],
      "additionalProperties": false,
      "properties": {
        "inflow": { "$ref": "#/$defs/text" },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "sectors": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/text" } },
        "goldenRule": { "$ref": "#/$defs/text" }
      }
    },
    "deepTalents": {
      "type": "object",
      "required": ["channel", "gift", "trap", "practice"],
      "additionalProperties": false,
      "properties": {
        "channel": { "$ref": "#/$defs/text" },
        "gift": { "$ref": "#/$defs/text" },
        "trap": { "$ref": "#/$defs/text" },
        "practice": { "$ref": "#/$defs/text" }
      }
    },
    "deepFamily": {
      "type": "object",
      "required": ["theme", "potential", "challenge", "questions", "practice"],
      "additionalProperties": false,
      "properties": {
        "theme": { "$ref": "#/$defs/text" },
        "potential": { "$ref": "#/$defs/text" },
        "challenge": { "$ref": "#/$defs/text" },
        "questions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } },
        "practice": { "$ref": "#/$defs/text" }
      }
    },
    "deepLove": {
      "type": "object",
      "required": ["attraction", "shadowPatterns", "harmonyKey"],
      "additionalProperties": false,
      "properties": {
        "attraction": { "$ref": "#/$defs/text" },
        "shadowPatterns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "harmonyKey": { "$ref": "#/$defs/text" }
      }
    }
  }
}
