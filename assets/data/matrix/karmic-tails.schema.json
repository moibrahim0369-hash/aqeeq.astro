{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Akeek Astro — Karmic tails bundle (Schema v2)",
  "type": "object",
  "required": ["schemaVersion", "contentType", "contentVersion", "updated", "language", "engineMapping", "safetyNote", "tails"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contentType": { "const": "karmic-tails" },
    "contentVersion": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "language": { "const": "ar" },
    "source": { "type": "string" },
    "engineMapping": { "enum": ["unverified", "verified"] },
    "safetyNote": { "$ref": "#/$defs/text" },
    "tails": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tail" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "^[^<>\"]*$" },
    "code": { "type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])-([1-9]|1[0-9]|2[0-2])-([1-9]|1[0-9]|2[0-2])$" },
    "genderVariant": {
      "type": "object",
      "required": ["childhoodRoots", "paradox"],
      "additionalProperties": false,
      "properties": {
        "childhoodRoots": { "$ref": "#/$defs/text" },
        "paradox": { "$ref": "#/$defs/text" }
      }
    },
    "tail": {
      "type": "object",
      "required": ["id", "code", "digits", "aliases", "title", "psychologicalDepth", "paradox", "childhoodRoots", "symbolicBodyNote", "protocol", "genderVariants", "meta"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "code": { "$ref": "#/$defs/code" },
        "digits": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 1, "maximum": 22 } },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "title": {
          "type": "object",
          "required": ["ar", "subtitle"],
          "additionalProperties": false,
          "properties": { "ar": { "$ref": "#/$defs/text" }, "subtitle": { "$ref": "#/$defs/text" } }
        },
        "psychologicalDepth": { "$ref": "#/$defs/text" },
        "paradox": { "$ref": "#/$defs/text" },
        "childhoodRoots": { "$ref": "#/$defs/text" },
        "symbolicBodyNote": { "$ref": "#/$defs/text" },
        "protocol": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/text" } },
        "genderVariants": {
          "type": "object",
          "required": ["female", "male"],
          "additionalProperties": false,
          "properties": {
            "female": { "$ref": "#/$defs/genderVariant" },
            "male": { "$ref": "#/$defs/genderVariant" }
          }
        },
        "meta": {
          "type": "object",
          "required": ["status", "source"],
          "properties": {
            "status": { "enum": ["draft", "review", "ready", "published"] },
            "source": { "enum": ["archive", "authored"] },
            "sourceSection": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
