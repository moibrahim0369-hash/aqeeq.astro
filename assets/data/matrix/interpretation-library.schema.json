{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aqeeq-astro.invalid/schemas/matrix-interpretation-library.schema.json",
  "title": "Aqeeq Matrix Interpretation Library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "libraryId",
    "contentState",
    "referenceState",
    "positions",
    "sources",
    "arcana",
    "combinationRules",
    "sectionLinks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "libraryId": {
      "const": "aqeeq.matrix.interpretations"
    },
    "contentState": {
      "enum": [
        "structure-only",
        "content-in-progress",
        "content-reviewed"
      ]
    },
    "referenceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "partially-verified",
            "verified"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "positions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dataPath",
          "kind",
          "labelSource",
          "meaningStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dataPath": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "existing-matrix-node"
          },
          "labelSource": {
            "type": "string"
          },
          "meaningStatus": {
            "enum": [
              "unverified",
              "verified"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "arcana": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "$ref": "#/$defs/arcana"
      }
    },
    "combinationRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "sectionLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sectionLink"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "edition",
        "locator",
        "verificationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "verificationStatus": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "textUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning",
        "strengths",
        "challenges",
        "innerTensions",
        "examples",
        "reflectionQuestions",
        "developmentSteps"
      ],
      "properties": {
        "meaning": {
          "type": [
            "string",
            "null"
          ]
        },
        "strengths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textUnit"
          }
        },
        "challenges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textUnit"
          }
        },
        "innerTensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textUnit"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textUnit"
          }
        },
        "reflectionQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "developmentSteps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textUnit"
          }
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "arcanaNumber",
        "positionId",
        "reviewStatus",
        "completeness",
        "sourceIds",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "arcanaNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 22
        },
        "positionId": {
          "type": "null"
        },
        "reviewStatus": {
          "enum": [
            "not-started",
            "draft",
            "in-review",
            "approved"
          ]
        },
        "completeness": {
          "enum": [
            "empty",
            "partial",
            "complete"
          ]
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      }
    },
    "positionInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "arcanaNumber",
        "positionId",
        "reviewStatus",
        "completeness",
        "sourceIds",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "arcanaNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 22
        },
        "positionId": {
          "type": "string"
        },
        "reviewStatus": {
          "enum": [
            "not-started",
            "draft",
            "in-review",
            "approved"
          ]
        },
        "completeness": {
          "enum": [
            "empty",
            "partial",
            "complete"
          ]
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      }
    },
    "arcana": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "arcanaNumber",
        "catalogRef",
        "coreInterpretation",
        "positionInterpretations"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "arcanaNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 22
        },
        "catalogRef": {
          "type": "string"
        },
        "coreInterpretation": {
          "$ref": "#/$defs/core"
        },
        "positionInterpretations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/positionInterpretation"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "arcanaNumbers",
        "positionIds",
        "ruleStatus",
        "relationshipStatus",
        "reviewStatus",
        "active",
        "sourceId",
        "conditions",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "arcanaNumbers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 22
          }
        },
        "positionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "ruleStatus": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "relationshipStatus": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "in-review",
            "approved"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      }
    },
    "sectionLink": {
      "type": "object",
      "required": [
        "id",
        "fromSectionId",
        "toSectionId",
        "ruleStatus",
        "relationshipStatus",
        "reviewStatus",
        "active",
        "sourceId",
        "conditions",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "fromSectionId": {
          "type": "string"
        },
        "toSectionId": {
          "type": "string"
        },
        "ruleStatus": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "relationshipStatus": {
          "enum": [
            "unverified",
            "verified"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "in-review",
            "approved"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      }
    }
  }
}
